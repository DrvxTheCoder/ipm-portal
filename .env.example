# Optional. With a key, receipts are read by Claude vision (/api/ocr).
# Without one, Tesseract.js reads them in the browser.
ANTHROPIC_API_KEY=
# OCR_MODEL=claude-haiku-4-5-20251001

# Where multiapp listens, as the portal's server sees it. The browser calls
# /api/portail/* on the portal itself and next.config.ts forwards it there, so
# the portal works from any address (a phone on the LAN included).
API_PROXY_TARGET=http://localhost:3000
# Optional: call multiapp directly from the browser instead of through the
# proxy. multiapp's PORTAL_ORIGIN must then be this portal's exact origin.
# NEXT_PUBLIC_API_URL=http://localhost:3000/api/portail
NEXT_PUBLIC_PORTAL_FIRM_SLUG=ipm-tawfeikh
# Optional, demo only: shown on the code screen. Same value as multiapp's DEMO_OTP.
# NEXT_PUBLIC_DEMO_CODE=2026
